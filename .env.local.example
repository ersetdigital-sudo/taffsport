# ============================================================================
# TAFF Sportwear Admin Panel — contoh environment variable untuk development lokal
# ============================================================================
# Salin file ini jadi .env.local lalu isi nilainya:
#   cp .env.local.example .env.local
#
# JANGAN pernah menaruh nilai asli di file ini — file ini ikut ter-commit.
# Gunakan project Supabase MILIK TAFF SPORTWEAR SENDIRI (jangan pakai punya orang lain).
# ============================================================================

# ── Supabase (wajib) ────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Hanya untuk server (endpoint notifikasi). Jangan pernah dipakai di client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Secret internal (wajib) ─────────────────────────────────────────────────
# Kunci enkripsi token Fonnte di tabel app_settings (AES-256-GCM).
SETTINGS_ENCRYPTION_KEY=generate-random-32-byte-string
# Penanda tangan token tracking customer (HMAC).
# Mengganti nilai ini saat produksi = semua link tracking yang sudah dikirim ke
# customer langsung mati. Set dulu di Vercel, baru ganti.
TRACK_SESSION_SECRET=generate-random-string
# Password dashboard Pesanan (/pesanan/orders, /pesanan/maklon).
PESANAN_PASSWORD=choose-a-dashboard-password
# Proteksi endpoint pengingat deadline (?secret=... atau header x-cron-secret).
CRON_SECRET=generate-random-string

# ── Cloudinary (upload foto desain & WO) ────────────────────────────────────
# Pakai unsigned upload preset, jadi dua baris NEXT_PUBLIC_* ini memang aman
# dipublikasikan ke browser. API key/secret HANYA untuk server (menghapus aset).
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
# Nilai yang dipakai upload dari sisi browser (harus sama dengan di atas).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ── URL publik aplikasi (dipakai saat membentuk link tracking) ───────────────
# Di lokal: http://localhost:3000 — di Vercel: domain produksi.
APP_URL=http://localhost:3000

# ── Meta Conversions API (opsional) ─────────────────────────────────────────
META_CAPI_ACCESS_TOKEN=
